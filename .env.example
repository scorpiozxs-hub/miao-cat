# 64px classifier; see training/README.md for shared preprocessing and training.
VITE_MODEL_URL=/models/quickdraw-8class-64.onnx
VITE_MODEL_VERSION=quickdraw-8class-64-v2
# Contract: grayscale [1,1,64,64], white ink on black, cat class index 0.
VITE_MODEL_SIZE=64
VITE_CAT_CLASS_INDEX=0
# Original Notion character image, when a usable local export is available.
VITE_MASCOT_URL=

# V4.1 browser manifest (optional until the trained model is ready).
# If set, the manifest must match the alpha-area-64-v2 browser contract.
VITE_MODEL_MANIFEST_URL=

# Public configuration only. Leave ENV_ID empty for drawing + local practice.
VITE_CLOUDBASE_ENV_ID=
VITE_CLOUDBASE_REGION=ap-shanghai
VITE_CLOUDBASE_API_FUNCTION=miao-api
